# ------------------------------------------------------------------------------
# 1. RENDER (BACKEND ENVIRONMENT VARIABLES)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=10000

# Database Configuration (Neon PostgreSQL for Cloud Production)
# Format: postgresql://<user>:<password>@<ep-id>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# For Local Offline Development (Uncomment below and comment DATABASE_URL above):
# DATABASE_URL="file:./dev.db"

# Security & Authentication
# Generate a random 32+ character string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="patchpulse_production_jwt_secret_key_2026_super_secure_token"
JWT_EXPIRES_IN="7d"

# AI Intelligence Pipeline
# Options: 'mock' (Deterministic, zero-latency, high-precision mock engine) or 'openai'
AI_MODE="mock"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Redis Cache (Optional - In-memory fallback is active if not supplied)
REDIS_URL="redis://localhost:6379"

# Media Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# GIS Map Tiles
MAP_TILE_PROVIDER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"


# ------------------------------------------------------------------------------
# 2. VERCEL (FRONTEND ENVIRONMENT VARIABLES)
# ------------------------------------------------------------------------------
# Point this to your live Render backend URL:
# e.g., https://patchpulse-api.onrender.com
VITE_API_URL="https://patchpulse-api.onrender.com"
