# PATCHPULSE Environment Configuration
# Hackday 1.0 - Participant: Pochiraju Kailash Ram Markandeya Sharma | Team: kailashsharma8

# Server Port
PORT=3000
NODE_ENV=development

# Database Configuration
# Local SQLite (Default for instant zero-dependency execution):
DATABASE_URL="file:./dev.db"
# Or PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://patchpulse:patchpulse_secret@localhost:5432/patchpulse_db?schema=public"

# Redis Configuration (Optional, graceful in-memory fallback enabled if offline)
REDIS_URL="redis://localhost:6379"

# Security & JWT Secrets (Change in production!)
JWT_SECRET="patchpulse_hackday_jwt_secret_key_2026_super_secure_token"
JWT_EXPIRES_IN="7d"

# AI Layer Configuration
# Options: 'mock' (Deterministic, high-quality, instant response) or 'openai'
AI_MODE=mock
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Map Tile Provider
MAP_TILE_PROVIDER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
