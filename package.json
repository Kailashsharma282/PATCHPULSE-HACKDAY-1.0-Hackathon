{
  "name": "patchpulse",
  "version": "1.0.0",
  "private": true,
  "description": "PATCHPULSE — AI Civic Intelligence & Verification Platform for HACKDAY 1.0",
  "author": "Pochiraju Kailash Ram Markandeya Sharma <kailashsharma8>",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace=apps/api run start:dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/api run build && npm --workspace=apps/web run build",
    "test": "npm --workspace=apps/api run test",
    "test:e2e": "npm --workspace=apps/api run test:e2e",
    "lint": "npm --workspace=apps/api run lint && npm --workspace=apps/web run lint",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "ts-node --transpile-only ./prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
